# Variáveis de ambiente necessárias para a Etapa 5 (Galeria de Clientes com Supabase)
# Crie um arquivo .env.local com as variáveis abaixo preenchidas com seus dados do Supabase

# Acesse: https://app.supabase.com → Seu Projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave secreta para proteção do painel admin (use a service_role key do Supabase)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# E-mail e senha do administrador (para criar via Supabase Auth → Users)
ADMIN_EMAIL=admin@gessoalves.store

# Variáveis de ambiente para a Etapa 6 (Formulário, Anti-Spam e E-mail)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=sua_site_key_aqui
RECAPTCHA_SECRET_KEY=sua_secret_key_aqui
RESEND_API_KEY=re_sua_chave_resend_aqui
NEXT_PUBLIC_SITE_URL=http://localhost:3000
