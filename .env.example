# =============================================================
# ARQUIVO DE EXEMPLO — NÃO contém chaves reais
# Copie este arquivo para .env.local e preencha com seus valores
# =============================================================
#
#   cp .env.example .env.local
#
# ⚠️  NUNCA commite o .env.local — ele está no .gitignore
# =============================================================

# ------------------------------------------------------------------
# Supabase
# Encontre em: https://supabase.com/dashboard → Settings → API
# ------------------------------------------------------------------

# URL pública do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anônima (segura para uso no frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# Chave de serviço — APENAS server-side, JAMAIS expor no cliente!
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------
# (Opcional) Resend — envio de e-mails
# Encontre em: https://resend.com/api-keys
# ------------------------------------------------------------------
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL=contato@gessoalves.store
RESEND_TO_EMAIL=contato@gessoalves.store

# ------------------------------------------------------------------
# (Opcional) Google reCAPTCHA v3
# Encontre em: https://www.google.com/recaptcha/admin
# ------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le_XXXXXXXXXXXXXXXXXXXXXXXX
RECAPTCHA_SECRET_KEY=6Le_XXXXXXXXXXXXXXXXXXXXXXXX

# Controle de Deploy
NUNCA envie arquivos, faça commits ou disparos para a Vercel sem autorização prévia. Sempre peça confirmação antes de executar qualquer envio.